# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets: any .env (root, server/github-api, ...) stays local. The *.example files are tracked.
.env
.env.*
!.env.example

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI-assistant tooling and browser-test output (may contain credentials)
.agents/
.claude/
skills-lock.json
.playwright/
.playwright-cli/

# Misc
.netlify/
*/linkedin-export/*
__pycache__/

# Tool caches and build leftovers
.vite/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
coverage/
.playwright-mcp/
*.tmp
*.bak
*.orig

# Keys and certificates must never be committed
*.pem
*.key
id_rsa*
id_ed25519*

# PM2 runtime files
.pm2/
*.pid

# NOT ignored on purpose: public/og/*.png (share cards made by `npm run og`) are committed,
# so the production build still has them if image generation is unavailable on the server.
