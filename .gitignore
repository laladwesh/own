# Secrets: any .env (root, server/github-api, ...) stays local. The *.example files are tracked.
.env
.env.*
!.env.example

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI-assistant tooling and browser-test output (may contain credentials)
.agents/
.claude/
skills-lock.json
.playwright/
.playwright-cli/

# Misc
.netlify/
*/linkedin-export/*
__pycache__/
